{#
  Ported from modules/packages/niri/niri.nix.
  Managed by Ansible — edit the role, not this file.
#}
{%- set dirkeys = {
      'qwerty':  {'left': 'H', 'right': 'L', 'up': 'K', 'down': 'J'},
      'colemak': {'left': 'N', 'right': 'I', 'up': 'U', 'down': 'Comma'},
    } -%}
{%- set k = dirkeys[wm_keyboard_layout] -%}
{%- set spawn_commands = [] -%}
{%- if wm_statusbar == 'waybar' -%}
{%-   set _ = spawn_commands.append(['waybar']) -%}
{%- endif -%}
{%- if enable_1password -%}
{%-   set _ = spawn_commands.append(['1password', '--silent']) -%}
{%- endif -%}
{%- for cmd in wm_exec_once -%}
{%-   set _ = spawn_commands.append(cmd.split(' ')) -%}
{%- endfor -%}
// Generated by Ansible from roles/niri/templates/config.kdl.j2
// Keybinding layout: {{ wm_keyboard_layout }}

input {
  keyboard {
    xkb {
      layout "{{ dotfiles_xkb_layout }}"
      options "{{ dotfiles_xkb_options }}"
    }
    numlock
  }

  touchpad {
    tap
    natural-scroll
  }

  mouse {
{% if wm_flat_mouse_accel %}
    accel-speed 0
    accel-profile "flat"
{% endif %}
  }

  focus-follows-mouse max-scroll-amount="0%"
}

gestures {
  hot-corners {
    off
  }
}

{% for mon in wm_monitors %}
output "{{ mon.name }}" {
  mode "{{ mon.mode }}"
  scale {{ mon.scale }}
  position x={{ mon.position_x }} y={{ mon.position_y }}
}
{% endfor %}

layout {
  gaps 16
  center-focused-column "never"

  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }

  default-column-width { proportion 0.5; }

  focus-ring {
    width 2
    active-color "#7fc8ff"
    inactive-color "#505050"
  }

  border {
    off
  }
}

{% if wm_main_monitor %}
workspace "tools" {
  open-on-output "{{ wm_main_monitor }}"
}
{% endif %}

{% for cmd in spawn_commands %}
spawn-at-startup {% for arg in cmd %}"{{ arg }}"{{ " " if not loop.last }}{% endfor %}

{% endfor %}

environment {
  DISPLAY ":0"
  XDG_SESSION_TYPE "wayland"
  XDG_CURRENT_DESKTOP "niri"
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
  // enabled by default
}

prefer-no-csd

window-rule {
  geometry-corner-radius 8
  clip-to-geometry true
}

// Steam games open fullscreen (niri tiles them at partial width otherwise)
window-rule {
  match app-id=r#"^steam_app_\d+$"#
  open-fullscreen true
}

{% if wm_streamcontroller_window_rule and wm_monitors | length > 0 %}
window-rule {
  match app-id="com.core447.StreamController"
  open-on-output "{{ wm_monitors[-1].name }}"
}
{% endif %}

binds {
  Mod+Shift+Slash { show-hotkey-overlay; }

  // Core bindings
  Mod+Q hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
  Mod+E hotkey-overlay-title="Yazi file manager" { spawn "kitty" "-e" "yazi"; }
  Mod+SPACE hotkey-overlay-title="Menu" {
{% if wm_statusbar == 'noctalia' %}
    spawn-sh "noctalia msg panel-toggle launcher";
{% else %}
    spawn "wofi" "--show" "drun" "--sort-order=alphabetical";
{% endif %}
  }
  Super+Escape hotkey-overlay-title="Lock the Screen" {
{% if wm_statusbar == 'noctalia' %}
    spawn-sh "noctalia msg session lock";
{% else %}
    spawn "swaylock";
{% endif %}
  }

  Mod+C repeat=false { close-window; }
  Mod+V { toggle-window-floating; }
  Mod+O { toggle-overview; }
{% if wm_audio_switcher_binds %}
  Mod+Shift+O hotkey-overlay-title="Switch audio output" { spawn "audio-output"; }
  Mod+Shift+M hotkey-overlay-title="Switch audio input" { spawn "audio-input"; }
  Mod+Shift+D hotkey-overlay-title="Switch audio device (in+out)" { spawn "audio-device"; }
{% endif %}

  // Focus movement ({{ wm_keyboard_layout }} directional keys)
  Mod+{{ k.left }} { focus-column-left; }
  Mod+{{ k.right }} { focus-column-right; }
  Mod+{{ k.up }} { focus-window-up; }
  Mod+{{ k.down }} { focus-window-down; }

  // Also support arrow keys
  Mod+Left { focus-column-left; }
  Mod+Down { focus-window-down; }
  Mod+Up { focus-window-up; }
  Mod+Right { focus-column-right; }

  // Move windows
  Mod+Shift+{{ k.left }} { move-column-left; }
  Mod+Shift+{{ k.right }} { move-column-right; }
  Mod+Shift+{{ k.up }} { move-window-up; }
  Mod+Shift+{{ k.down }} { move-window-down; }

  Mod+Shift+Left { move-column-left; }
  Mod+Shift+Down { move-window-down; }
  Mod+Shift+Up { move-window-up; }
  Mod+Shift+Right { move-column-right; }

  // Focus monitors
  Mod+Ctrl+{{ k.left }} { focus-monitor-left; }
  Mod+Ctrl+{{ k.right }} { focus-monitor-right; }
  Mod+Ctrl+{{ k.up }} { focus-monitor-up; }
  Mod+Ctrl+{{ k.down }} { focus-monitor-down; }

  Mod+Ctrl+Left { focus-monitor-left; }
  Mod+Ctrl+Down { focus-monitor-down; }
  Mod+Ctrl+Up { focus-monitor-up; }
  Mod+Ctrl+Right { focus-monitor-right; }

  // Move to monitors
  Mod+Shift+Ctrl+{{ k.left }} { move-column-to-monitor-left; }
  Mod+Shift+Ctrl+{{ k.right }} { move-column-to-monitor-right; }
  Mod+Shift+Ctrl+{{ k.up }} { move-column-to-monitor-up; }
  Mod+Shift+Ctrl+{{ k.down }} { move-column-to-monitor-down; }

  Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
  Mod+Shift+Ctrl+Down { move-column-to-monitor-down; }
  Mod+Shift+Ctrl+Up { move-column-to-monitor-up; }
  Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

  // Workspaces
{% for ws in range(1, 10) %}
  Mod+{{ ws }} { focus-workspace {{ ws }}; }
{% endfor %}

{% for ws in range(1, 10) %}
  Mod+Shift+{{ ws }} { move-column-to-workspace {{ ws }}; }
{% endfor %}

  Mod+F1 { focus-workspace "tools"; }
  Mod+Shift+F1 { move-column-to-workspace "tools"; }

  // Window management
  Mod+R { switch-preset-column-width; }
  Mod+Shift+R { switch-preset-window-height; }
  Mod+Ctrl+R { reset-window-height; }
  Mod+F { maximize-column; }
  Mod+Shift+F { fullscreen-window; }
  Mod+T { consume-window-into-column; }
  Mod+Shift+T { expel-window-from-column; }

  // Screenshots
  Print { spawn "sh" "-c" "grim -g \"$(slurp)\" - | swappy -f -"; }
  Shift+Print { spawn "sh" "-c" "grim - | swappy -f -"; }
  Ctrl+Print { spawn "sh" "-c" "grim -g \"$(slurp -o)\" - | swappy -f -"; }

  // Session
  Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
  Mod+Shift+E { quit; }
  Ctrl+Alt+Delete { quit; }

  // Mouse wheel scrolling
  Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
  Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

  // Multimedia / laptop keys (work while the screen is locked)
  XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
  XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
  XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
  XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
  XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%+"; }
  XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%-"; }
  XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
  XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
  XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
  XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
}
