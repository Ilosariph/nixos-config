+def fscl_from_records(calibration, records):
+    """Take the FSCl comb record from the Hardware volume when there is
+    exactly one and it reads as one. Read through APFS it is whole; carving
+    the raw container breaks a record whose extents are not contiguous (seen
+    on J293: the tail, secb included, comes from an unrelated block and the
+    enclave refuses it with LOAD_CALIBRATION status 0x1c)."""
+    named = [name for name in records if name.startswith('FSCl-')]
+    if len(named) != 1 or len(records[named[0]]) > SOURCE_LIMIT:
+        return False
+    try:
+        calibration.data = fscl_record(records[named[0]])
+    except Refused:
+        return False
+    calibration.source = 'read from the factory records'
+    calibration.evidence = {'source': named[0],
+                            'source_sha384': hashlib.sha384(calibration.data).hexdigest()}
+    return True
+
