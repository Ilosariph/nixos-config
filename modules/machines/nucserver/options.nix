{ config, pkgs, ... }:
let
  smb = name: config.sops.secrets."smb-${name}".path;
  immich = "/home/docker-data/immich";
  immichNas = "/mnt/immich-backup";
in
{
  dotfiles.sops.enable = true;
  dotfiles.sops.host = "nucserver";
  dotfiles.deploy.target.enable = true;
  dotfiles.deploy.target.trustedPublicKeys = [ config.dotfiles.private.nix.mainpcSigningPublicKey ];
  dotfiles.kernel = "stable";
  dotfiles.bootloader.type = "grub";
  dotfiles.bootloader.grubDevice = "/dev/nvme0n1";
  dotfiles.programs._1password.sshAgent = false;
  dotfiles.services.ssh.enable = true;
  dotfiles.services.ssh.authorizedKeys = config.dotfiles.private.ssh.authorizedKeys;
  dotfiles.services.fail2ban.enable = true;
  dotfiles.services.pullSwitch.enable = true;
  dotfiles.services.pangolinNewt = {
    enable = true;
    endpoint = "https://${config.dotfiles.private.domains.pangolin}";
    idSecret = "nucserver-newt-id";
    secretSecret = "nucserver-newt-secret";
  };
  dotfiles.services.backup.enable = true;
  dotfiles.services.backup.jobs = [
    {
      # Same mirror as the old docker-backup.sh cron job. Root: some stack dirs
      # are root- or container-owned.
      name = "docker-configs";
      source = "/home/simon/docker/";
      destination = "/mnt/docker-backup/nucserver";
      calendar = "*-*-* 03:00:00";
      mode = "sync";
      user = "root";
      sqlite = true;
    }
    {
      # Same NAS layout as the old backup-immich.sh cron job. thumbs and
      # encoded-video are regenerated by Immich. The last two excludes keep
      # sync's --delete off the files the pre-command puts next to the library.
      name = "immich";
      source = "${immich}/library/";
      destination = "${immichNas}/library";
      calendar = "*-*-* 03:00:00";
      mode = "sync";
      user = "root";
      excludes = [ "/thumbs/" "/encoded-video/" "/backups/" "/docker-compose.yml" "/.env" ];
      preCommand = ''
        dump="${immichNas}/db/immich_db_$(date +%Y-%m-%d_%H-%M-%S).sql.gz"
        ${config.virtualisation.docker.package}/bin/docker exec immich_postgres \
          pg_dumpall --clean --if-exists --username=postgres | ${pkgs.gzip}/bin/gzip > "$dump"
        cp -f ${immich}/docker-compose.yml ${immich}/.env ${immichNas}/library/
      '';
    }
  ];
  # Docker bind-mounts these: idle-timeout=0 (last value wins over the shares
  # module's 60s) so the mount under a running container never expires.
  # gid 1000 is what the containers run as (PGID=1000), same as on Ubuntu.
  dotfiles.shares = [
    {
      mountPoint = "/mnt/arr";
      share = "arr";
      credentials = smb "arr";
      gid = 1000;
      extraOptions = [ "x-systemd.idle-timeout=0" ];
    }
    {
      mountPoint = "/mnt/immich-backup";
      share = "immich";
      credentials = smb "immich";
      gid = 1000;
      extraOptions = [ "x-systemd.idle-timeout=0" ];
    }
    {
      mountPoint = "/mnt/docker-backup";
      share = "docker-backup";
      credentials = smb "docker-backup";
      gid = 1000;
      # Server rejects native symlinks (rsync code 23); store them as MF symlink files.
      extraOptions = [ "mfsymlinks" "x-systemd.idle-timeout=0" ];
    }
  ];
  dotfiles.network = {
    hostname = "nucserver";
    interface = "eno1";
    staticIP = "${config.dotfiles.private.hosts.nucserver}/24";
    gateway = config.dotfiles.private.lan.gateway;
    wakeOnLan = true;
    lanHosts = [ "evo" ];
  };
}
